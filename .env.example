# ================================================================
# .env.example – Copy to .env and fill in your values
# NEVER commit the real .env file to version control
# ================================================================

# ── Flask ──────────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-64-char-string-in-production

# ── MySQL Database ─────────────────────────────────────────────
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=explainable_ai_health

# ── Email (Gmail SMTP example) ─────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_DEFAULT_SENDER=noreply@healthai.com

# ── Optional: Port override ────────────────────────────────────
PORT=5000

# ── Optional: Local demo / login test scripts ──────────────────
DEMO_USER_PASSWORD=
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
